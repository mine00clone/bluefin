# Bluefin Trading Bot - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# Sui Wallet Authentication (Required)
# =============================================================================

# Your Sui wallet private key (hex format, required)
# Used for signing authentication payloads and transactions
#
# How to obtain:
#   1. Sui Wallet browser extension -> Settings -> Export Private Key
#   2. Or via CLI: sui keytool generate ed25519
#
# Format: hex string without 0x prefix (64 characters for Ed25519)
# Example: 1a2b3c4d5e6f...
BLUEFIN_PRIVATE_KEY=

# Your Sui account address (optional, can be derived from private key)
# Format: 0x followed by 64 hex characters
# Example: 0x1234567890abcdef...
BLUEFIN_ACCOUNT_ADDRESS=

# =============================================================================
# Optional Settings
# =============================================================================

# Environment override (default: from config/default.toml)
# Values: staging, prod
# BLUEFIN_ENV=staging

# Log level override
# Values: trace, debug, info, warn, error
# RUST_LOG=info
